# Voice Detection API - Environment Configuration
# Copy this file to .env and fill in your values

# Server
VD_HOST=0.0.0.0
VD_PORT=8000
VD_DEBUG=false

# API Authentication
VD_API_KEY=your_secure_api_key_here
VD_RATE_LIMIT_MINUTE=60
VD_RATE_LIMIT_HOUR=1000

# Privacy
VD_STORE_RAW_AUDIO=false
VD_ANONYMIZE_CALLER_ID=true
VD_FEATURE_RETENTION_DAYS=30
VD_LOG_RETENTION_DAYS=90

# Model
VD_MODEL_PATH=voice_detection_app/trained_model.pth
VD_ONNX_PATH=voice_detection_app/trained_model.onnx

# Risk Thresholds
VD_HIGH_RISK_THRESHOLD=0.75
VD_MEDIUM_RISK_THRESHOLD=0.45
VD_LOW_RISK_THRESHOLD=0.2

# Logging
VD_LOG_LEVEL=INFO

# Alerts (optional)
VD_WEBHOOK_URL=
VD_EMAIL_RECIPIENTS=
